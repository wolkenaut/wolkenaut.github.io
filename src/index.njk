---
layout: layouts/base.njk
title: Home
description: James Collier - mathematics, astrophotography, and data engineering.
---
{% from "partials/writings-list.njk" import writingsList %}

<div class="topic-panel" id="home" data-panel="home">
  <section class="hero" id="hero">
    <div class="container hero-content hero-grid">
      <div class="hero-intro">
        <p class="eyebrow">{{ site.tagline }}</p>
        <h1>{{ site.name }}</h1>
      </div>
      <div class="hero-writings">
        <div class="hero-writings-group panel">
          <h2 class="panel-title">Academic Writings</h2>
          {{ writingsList(collections.writings | byAnyTag(["math", "astronomy"]) | reverse | pinnedFirst | limit(3), "Coming soon.") }}
        </div>
        <div class="hero-writings-group panel">
          <h2 class="panel-title">Personal Writings</h2>
          {{ writingsList(collections.writings | byTag("interests") | reverse | limit(3), "Coming soon.") }}
        </div>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="container">
      <div class="reveal panel about-grid">
        <div class="about-text">
          <h2 class="panel-title">About</h2>
          <p>
            Hello! My name is James Collier and I am a Yale alum who graduated in
            2026. I am studying mathematics, but I am also passionate about
            astronomy, physics, statistics, and linguistics. I've been an
            astrophotographer, an astronomy teacher, and currently do work in
            data engineering.
          </p>
        </div>
        {% if "about/portrait.jpg" | fileExists %}
          <div class="photo-block about-photo">
            {% image "about/portrait.jpg", "Portrait of James Collier.", { sizes: "(min-width: 768px) 200px, 100vw" } %}
          </div>
        {% else %}
          <div class="placeholder-block about-photo" style="aspect-ratio: 1 / 1;">
            <span>about/portrait.jpg - 1200×1200</span>
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <div class="reveal">
        <h2>Contact</h2>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        {% if site.links.length %}
          <ul class="footer-links">
            {% for link in site.links %}
              <li><a href="{{ link.url }}">{{ link.label }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="eyebrow">External profiles - coming soon.</p>
        {% endif %}
      </div>
    </div>
  </section>
</div>

<div class="topic-panel" id="mathematics" data-panel="mathematics" hidden>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Mathematics</p>
      <h2>Hyperbolic geometry, knot theory, and independent research toward a senior thesis.</h2>
    </div>
  </section>

  <section id="mathematics-writings" class="writings-compact">
    <div class="container">
      <div class="reveal panel">
        <h3 class="panel-title">Writings</h3>
        {{ writingsList(collections.writings | byTag("math") | reverse | limit(3), "Essays on hyperbolic geometry, knot theory, and other things worth writing down - coming soon.") }}
      </div>
    </div>
  </section>

  <section id="mathematics-projects">
    <div class="container">
      <div class="reveal">
        <h3>Projects</h3>
        <div class="cards-grid">
          {% for project in mathProjects %}
            <article class="card project-card">
              <figure style="margin-bottom: var(--sp-2);">
                {% if project.filename | fileExists %}
                  <div class="photo-block">
                    {% image project.filename, project.alt, { sizes: "(min-width: 768px) 33vw, 100vw" } %}
                  </div>
                {% else %}
                  <div class="placeholder-block" style="aspect-ratio: 3 / 2;">
                    <span>{{ project.filename }} - {{ project.dimensions }}</span>
                  </div>
                {% endif %}
                <figcaption class="photo-caption">{{ project.caption }}</figcaption>
              </figure>
              <p class="eyebrow">{{ project.term }} - {{ project.advisor }}</p>
              <h3>{{ project.title }}</h3>
              <p>{{ project.description }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section id="mathematics-coursework">
    <div class="container">
      <div class="reveal">
        <h3>Coursework</h3>
        <dl class="coursework">
          {% for group in coursework %}
            <dt>{{ group.year }}</dt>
            <dd>{{ group.courses | join(", ") }}</dd>
          {% endfor %}
        </dl>
      </div>
    </div>
  </section>
</div>

<div class="topic-panel" id="astronomy" data-panel="astronomy" hidden>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Astronomy</p>
      <h2>Astrophotography and research on the black hole X-ray binary V4641 Sagittarii.</h2>
    </div>
  </section>

  <section id="astronomy-writings" class="writings-compact">
    <div class="container">
      <div class="reveal panel">
        <h3 class="panel-title">Writings</h3>
        {{ writingsList(collections.writings | byTag("astronomy") | reverse | limit(3), "Notes on astrophotography and observing - coming soon.") }}
      </div>
    </div>
  </section>

  <section id="astronomy-gallery">
    <div class="container">
      <div class="reveal">
        <h3>Gallery</h3>
        <div class="gallery-grid">
          {% for item in gallery %}
            <figure class="gallery-item">
              {% if item.filename | fileExists %}
                <div class="photo-block">
                  {% image item.filename, item.alt, { sizes: "(min-width: 768px) 33vw, 100vw" } %}
                </div>
              {% else %}
                <div class="placeholder-block" style="aspect-ratio: 3 / 2;">
                  <span>{{ item.filename }} - {{ item.dimensions }}</span>
                </div>
              {% endif %}
              <figcaption>{{ item.title }}</figcaption>
            </figure>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section id="astronomy-research">
    <div class="container">
      <div class="reveal panel">
        <h3 class="panel-title">Research</h3>
        <figure class="research-photo">
          {% if "astro/research.png" | fileExists %}
            <div class="photo-block">
              {% image "astro/research.png", "Research photo.", { sizes: "(min-width: 768px) 66vw, 100vw" } %}
            </div>
          {% else %}
            <div class="placeholder-block" style="aspect-ratio: 4 / 3;">
              <span>astro/research.png - 1600×1200</span>
            </div>
          {% endif %}
          <figcaption class="photo-caption">Caption for the research photo.</figcaption>
        </figure>
        <p class="eyebrow">STARS Summer Research Program, 2023 - Prof. Charles Bailyn</p>
        <p>
          Analysed twenty years of optical and infrared data from the black hole
          X-ray binary V4641 Sagittarii. Used Python, Excel, Siril, and SAOImage
          for stellar data analysis; NumPy, AstroPy, and SciPy for timelines and
          optical data initialisation - alignment, dithering, and differential
          aperture photometry.
        </p>
      </div>
    </div>
  </section>
</div>

<div class="topic-panel" id="interests" data-panel="interests" hidden>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Interests</p>
      <h2>Factorio, crosswords, minesweeper, and other problem-solving games.</h2>
    </div>
  </section>

  <section id="interests-writings" class="writings-compact">
    <div class="container">
      <div class="reveal panel">
        <h3 class="panel-title">Writings</h3>
        {{ writingsList(collections.writings | byTag("interests") | reverse | limit(3), "Notes on whatever puzzle has my attention this week - coming soon.") }}
      </div>
    </div>
  </section>

  <section id="interests-list">
    <div class="container">
      <div class="reveal">
        <p class="eyebrow">Problem-solving games</p>
        <div class="cards-grid">
          {% for interest in interests %}
            <article class="card">
              {% if interest.filename | fileExists %}
                <div class="photo-block" style="margin-bottom: var(--sp-2);">
                  {% image interest.filename, interest.alt, { sizes: "(min-width: 768px) 25vw, 50vw" } %}
                </div>
              {% else %}
                <div class="placeholder-block" style="aspect-ratio: 3 / 2; margin-bottom: var(--sp-2);">
                  <span>{{ interest.filename }} - {{ interest.dimensions }}</span>
                </div>
              {% endif %}
              <h3>{{ interest.title }}</h3>
              <p>{{ interest.description }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</div>

<div class="topic-panel" id="writings" data-panel="writings" hidden>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Writings</p>
      <h2>All essays and notes, grouped by subject.</h2>
    </div>
  </section>

  <section id="writings-math">
    <div class="container">
      <div class="reveal panel">
        <h3 class="panel-title">Mathematics</h3>
        {{ writingsList(collections.writings | byTag("math") | reverse, "Coming soon.") }}
      </div>
    </div>
  </section>

  <section id="writings-astronomy">
    <div class="container">
      <div class="reveal panel">
        <h3 class="panel-title">Astronomy</h3>
        {{ writingsList(collections.writings | byTag("astronomy") | reverse, "Coming soon.") }}
      </div>
    </div>
  </section>

  <section id="writings-interests">
    <div class="container">
      <div class="reveal panel">
        <h3 class="panel-title">Interests</h3>
        {{ writingsList(collections.writings | byTag("interests") | reverse, "Coming soon.") }}
      </div>
    </div>
  </section>
</div>
