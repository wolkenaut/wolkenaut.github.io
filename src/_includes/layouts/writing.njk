---
layout: layouts/base.njk
---
<article class="writing">
  <div class="container">
    <p class="writing-back"><a href="/#writings">← Back to Writings</a></p>
    <p class="eyebrow"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
    <h1>{{ title }}</h1>
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</article>
