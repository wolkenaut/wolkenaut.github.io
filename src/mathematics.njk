---
layout: layouts/page.njk
eyebrow: Mathematics
title: Mathematics
description: Hyperbolic geometry, knot theory, and coursework — James Collier's mathematics page.
---
{% from "partials/project-card.njk" import projectCard %}

<section id="projects" data-nav-section="/mathematics/">
  <div class="container">
    <div class="reveal">
      <h2>Projects</h2>
      <div class="cards-grid">
        {% for project in mathProjects %}
          {{ projectCard(project) }}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section id="writings" data-nav-section="/mathematics/">
  <div class="container">
    <div class="reveal">
      <h2>Writings</h2>
      {% set writingsList = collections.writings | reverse %}
      {% if writingsList.length %}
        <ul class="writings-list">
          {% for post in writingsList %}
            <li>
              <a href="{{ post.url }}">{{ post.data.title }}</a>
              <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="eyebrow">Essays on hyperbolic geometry, knot theory, and other things worth writing down — coming soon.</p>
      {% endif %}
    </div>
  </div>
</section>

<section id="coursework" data-nav-section="/mathematics/">
  <div class="container">
    <div class="reveal">
      <h2>Coursework</h2>
      <dl class="coursework">
        {% for group in coursework %}
          <dt>{{ group.year }}</dt>
          <dd>{{ group.courses | join(", ") }}</dd>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>
