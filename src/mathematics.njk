---
layout: layouts/page.njk
eyebrow: Mathematics
title: Mathematics
description: Hyperbolic geometry, knot theory, and coursework — James Collier's mathematics page.
---
{% from "partials/project-card.njk" import projectCard %}
{% from "partials/writings-list.njk" import writingsList %}

<section id="writings" class="writings-compact" data-nav-section="/mathematics/">
  <div class="container">
    <div class="reveal panel">
      <h2 class="panel-title">Writings</h2>
      {{ writingsList(collections.writings | byTag("math") | reverse | limit(3), "Essays on hyperbolic geometry, knot theory, and other things worth writing down — coming soon.") }}
    </div>
  </div>
</section>

<section id="projects" data-nav-section="/mathematics/">
  <div class="container">
    <div class="reveal">
      <h2>Projects</h2>
      <div class="cards-grid">
        {% for project in mathProjects %}
          {{ projectCard(project) }}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section id="coursework" data-nav-section="/mathematics/">
  <div class="container">
    <div class="reveal">
      <h2>Coursework</h2>
      <dl class="coursework">
        {% for group in coursework %}
          <dt>{{ group.year }}</dt>
          <dd>{{ group.courses | join(", ") }}</dd>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>
